{
  "description": "wpf-net472-airgap-dev-pack hooks - .NET SDK version check, XAML validation, MVVM violation detection, build error diagnosis, code formatting, per-project language preference loader, WPF ControlTemplate/Style/animation authoring-rules injection, and net472/net48 + offline + hand-rolled-MVVM hard-guardrails injection (SessionStart) (C# file-based apps, .NET SDK 10.0.300+ required). Offline fork: no online-MCP dependency checks and no context7/Microsoft-Learn reminders. Note: feedback document anonymity audit and Microsoft skill creator reminder are wired through skill frontmatter, not here.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "dotnet \"${CLAUDE_PLUGIN_ROOT}/hooks/DotnetVersionChecker.cs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "dotnet \"${CLAUDE_PLUGIN_ROOT}/hooks/LanguagePreferenceLoader.cs\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "dotnet \"${CLAUDE_PLUGIN_ROOT}/hooks/WpfAuthoringRulesLoader.cs\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "dotnet \"${CLAUDE_PLUGIN_ROOT}/hooks/Net472GuardrailsLoader.cs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__.*WpfDevPackMcp.*",
        "hooks": [
          {
            "type": "command",
            "command": "dotnet \"${CLAUDE_PLUGIN_ROOT}/hooks/RepoPathGuard.cs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(*.xaml)",
            "command": "dotnet \"${CLAUDE_PLUGIN_ROOT}/hooks/XamlValidator.cs\"",
            "timeout": 15
          },
          {
            "type": "command",
            "if": "Edit(*.cs)",
            "command": "dotnet \"${CLAUDE_PLUGIN_ROOT}/hooks/MvvmViolationDetector.cs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Edit(*.cs)",
            "command": "dotnet \"${CLAUDE_PLUGIN_ROOT}/hooks/CodeFormatter.cs\"",
            "timeout": 45
          },
          {
            "type": "command",
            "if": "Edit(*.xaml)",
            "command": "dotnet \"${CLAUDE_PLUGIN_ROOT}/hooks/CodeFormatter.cs\"",
            "timeout": 45
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "if": "Write(*.xaml)",
            "command": "dotnet \"${CLAUDE_PLUGIN_ROOT}/hooks/XamlValidator.cs\"",
            "timeout": 15
          },
          {
            "type": "command",
            "if": "Write(*.cs)",
            "command": "dotnet \"${CLAUDE_PLUGIN_ROOT}/hooks/MvvmViolationDetector.cs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Write(*.cs)",
            "command": "dotnet \"${CLAUDE_PLUGIN_ROOT}/hooks/CodeFormatter.cs\"",
            "timeout": 45
          },
          {
            "type": "command",
            "if": "Write(*.xaml)",
            "command": "dotnet \"${CLAUDE_PLUGIN_ROOT}/hooks/CodeFormatter.cs\"",
            "timeout": 45
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "dotnet \"${CLAUDE_PLUGIN_ROOT}/hooks/BuildErrorDiagnoser.cs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
